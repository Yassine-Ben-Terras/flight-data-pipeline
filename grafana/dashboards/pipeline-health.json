    {
      "id": 2,
      "title": "Dernier appel réussi · âge",
      "type": "stat",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "flight-warehouse"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "flight-warehouse"
          },
          "rawSql": "SELECT extract(epoch FROM now()-max(recorded_at)) AS age FROM pipeline_metrics WHERE component='producer' AND source='live'",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "noValue": "En attente",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#73BF69",
                "value": null
              },
              {
                "color": "#FF9830",
                "value": 120
              },
              {
                "color": "#F2495C",
                "value": 300
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "auto",
        "wideLayout": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 3,
      "title": "Crédits API restants",
      "type": "stat",
      "description": "Dernier solde communiqué par OpenSky ; ce n’est pas une estimation.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "flight-warehouse"
      },
      "gridPos": {
        "x": 6,
        "y": 3,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "flight-warehouse"
          },
          "rawSql": "SELECT credits_remaining AS credits FROM pipeline_metrics WHERE component='producer' AND source='live' AND credits_remaining IS NOT NULL ORDER BY recorded_at DESC LIMIT 1",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "noValue": "En attente",
          "color": {
            "mode": "fixed",
            "fixedColor": "#73BF69"
          }
        },
        "overrides": []
