    {
      "id": 5,
      "title": "Crédits estimés · jour UTC",
      "type": "stat",
      "description": "Somme des coûts estimés des appels réussis enregistrés ; d’autres usages du compte peuvent consommer des crédits.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "flight-warehouse"
      },
      "gridPos": {
        "x": 18,
        "y": 3,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "flight-warehouse"
          },
          "rawSql": "SELECT coalesce(sum(credits_estimated),0) AS credits FROM pipeline_metrics WHERE component='producer' AND source='live' AND recorded_at >= date_trunc('day',now())",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "noValue": "En attente",
          "color": {
            "mode": "fixed",
            "fixedColor": "#FF9830"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "auto",
        "wideLayout": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 6,
      "title": "Délai collecte → stockage · médiane / p95",
      "type": "timeseries",
      "description": "Mesuré après la réponse API, jusqu’à l’écriture dans PostgreSQL. Uniquement les observations réelles.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "flight-warehouse"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "flight-warehouse"
          },
          "rawSql": "SELECT date_trunc('minute',ingested_at) AS time,\n                percentile_cont(0.5) within group (order by extract(epoch FROM ingested_at-polled_at)) AS \"Médiane\",\n                percentile_cont(0.95) within group (order by extract(epoch FROM ingested_at-polled_at)) AS \"P95\" FROM raw_flight_states WHERE source='live' AND $__timeFilter(ingested_at) GROUP BY 1 ORDER BY 1",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2,
          "noValue": "En attente",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": false,
            "axisBorderShow": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
