    {
      "id": 11,
      "title": "Derniers appels OpenSky réussis · UTC",
      "type": "table",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "flight-warehouse"
      },
      "gridPos": {
        "x": 8,
        "y": 23,
        "w": 16,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "flight-warehouse"
          },
          "rawSql": "SELECT to_char(recorded_at AT TIME ZONE 'UTC','YYYY-MM-DD HH24:MI:SS') AS \"Appel UTC\",\n                batch_size AS \"Avions\",credits_remaining AS \"Crédits restants\",\n                round(duration_ms::numeric) AS \"Durée (ms)\" FROM pipeline_metrics WHERE component='producer' AND source='live' ORDER BY recorded_at DESC LIMIT 15",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
