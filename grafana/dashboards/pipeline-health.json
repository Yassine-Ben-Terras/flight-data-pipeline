      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "flight-warehouse"
          },
          "rawSql": "SELECT count(*) AS observations FROM raw_flight_states WHERE source='live' AND $__timeFilter(ingested_at)",
