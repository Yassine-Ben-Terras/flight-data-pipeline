        "textMode": "auto",
        "wideLayout": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 4,
      "title": "Observations reçues · période",
      "type": "stat",
      "description": "Positions dédupliquées reçues pendant la période sélectionnée.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "flight-warehouse"
      },
      "gridPos": {
        "x": 12,
        "y": 3,
        "w": 6,
        "h": 4
