# Dashboards show real OpenSky data only. Import credentials before starting.
# SOURCE_MODE=demo is available for offline ingestion/CI tests, not the interface.
SOURCE_MODE=live
OPENSKY_COVERAGE=global
POSTGRES_PASSWORD=local-warehouse-password
GRAFANA_PASSWORD=local-dashboard-password
# Used only with OPENSKY_COVERAGE=regional. Global: 4 credits/request, 96s at budget 3600.
BBOX_LAMIN=33
BBOX_LOMIN=-7
BBOX_LAMAX=37
BBOX_LOMAX=-2
DAILY_CREDIT_BUDGET=3600
RAW_RETENTION_DAYS=14
CURRENT_RETENTION_HOURS=24
DBT_INTERVAL_SECONDS=300
